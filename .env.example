# 光合画廊 Photosynth 环境变量样例（复制为 .env 后填写；.env 已被 gitignore）
# 密钥纪律（DESIGN 6.3）：全部只进服务端容器；任何变量不得进 NEXT_PUBLIC_*

# 管理登录令牌（必填；空值/changeme 等示例值拒绝启动）
ADMIN_TOKEN=

# 签名 Cookie 密钥（必填，≥32 字符随机串，仅存在于 api 容器）
# 生成示例：openssl rand -hex 32
SESSION_SECRET=

# SQLite（WAL），容器内路径固定 /data/gallery.db（bind mount ./data）
DATABASE_URL=sqlite:////data/gallery.db

# 首次启动（works 为空）时写入演示种子数据（12 图 + 2 视频）；生产可关
SEED_DEMO=true

# 对外端口（仅绑宿主 127.0.0.1，由外层反代/CF 做 TLS）
PORT=3000

# 可选：用于生成分享链接 / OG URL
PUBLIC_BASE_URL=
